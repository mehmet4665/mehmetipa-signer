{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mehmetipa-signing",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "SigningContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SIGNER", "class_name": "SigningContainer" },
      { "name": "QUEUE", "class_name": "SigningQueue" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SigningContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["SigningQueue"] }
  ],
  "r2_buckets": [
    { "binding": "CERTS", "bucket_name": "mehmetipa-vault-2026" }
  ],
  "observability": { "enabled": true }
}
