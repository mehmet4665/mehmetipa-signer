{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mehmetipa-signing",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "SigningContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SIGNER", "class_name": "SigningContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SigningContainer"] }
  ],
  "observability": { "enabled": true }
}
